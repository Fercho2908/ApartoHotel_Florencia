---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
---

<div class="map-block">
  <div class="map-container">
    <iframe
      src={SITE.mapsEmbed}
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Ubicación de Aparto-Hotel Florencia en Calle Bolívar, Güiria"
    ></iframe>
  </div>
  <div class="map-details">
    <p class="map-address">
      <Icon name="MapPin" size={20} />
      {SITE.address}
    </p>
    <a class="btn btn-secondary map-directions" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">
      Ver en Google Maps
    </a>
  </div>
</div>

<style>
  .map-block {
    display: grid;
    gap: var(--space-lg);
  }

  .map-container {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 9;
  }

  .map-container iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .map-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .map-address {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    max-width: 40rem;
    margin: 0;
  }

  .map-directions {
    white-space: nowrap;
  }
</style>