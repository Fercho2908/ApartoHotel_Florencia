---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base
  title="Página no encontrada"
  description="La página solicitada no existe en Aparto-Hotel Florencia. Vuelva al inicio o contáctenos."
  canonicalPath="/404/"
>
  <section class="notfound">
    <div class="container notfound-inner">
      <p class="notfound-code">404</p>
      <h1>Página no encontrada</h1>
      <p>
        La página que busca no existe o fue movida. Puede volver al inicio o
        contactarnos directamente.
      </p>
      <div class="notfound-actions">
        <a class="btn btn-primary" href="/">Volver al Inicio</a>
        <a class="btn btn-secondary" href="/contacto/">Contactar</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-block: var(--space-4xl);
    text-align: center;
  }

  .notfound-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    max-width: 36rem;
  }

  .notfound-code {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 10vw, 7rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin: 0;
    max-width: none;
  }

  .notfound h1 {
    font-size: var(--step-3);
    color: var(--color-text);
  }

  .notfound p:not(.notfound-code) {
    color: var(--color-text-soft);
    max-width: 32rem;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
    margin-top: var(--space-md);
  }
</style>